# Frontend environment (Vite). Values are inlined at BUILD time — changing one
# needs a redeploy, not a restart.
#
# Local dev: leave blank. Vite proxies /api and /media to http://localhost:4000.
# Production: your deployed API origin, with NO trailing slash (the client
# appends /api itself), e.g. https://mkt-studio-api.onrender.com
VITE_API_URL=
